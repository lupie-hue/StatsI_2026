col = "violet",
pch = 19,
cex = 0.7
)
abline(
lm(expenditure[[vars[i]]] ~ expenditure[[vars[j]]])
)
r <- cor(
expenditure[[vars[i]]],
expenditure[[vars[j]]]
)
mtext(
paste("r =", round(r, 2))
)
}
}
