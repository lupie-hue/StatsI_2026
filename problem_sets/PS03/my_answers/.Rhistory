# Observed frequencies
obs <- matrix(c(14, 6, 7,
7, 7, 1),
nrow = 2, byrow = TRUE,
dimnames = list(c("Upper class", "Lower class"),
c("Not stopped", "Bribe requested", "Stopped/given warning")))
abs
print(abs)
freq <- matrix(c(14, 6, 7,
7, 7, 1),
nrow = 2, byrow = TRUE,
dimnames = list(c("Upper class", "Lower class"),
c("Not stopped", "Bribe requested", "Stopped/given warning")))
freq
View(obs)
obs_freq <- matrix(c(14, 6, 7,
7, 7, 1),
nrow = 2, byrow = TRUE,
dimnames = list(c("Upper class", "Lower class"),
c("Not stopped", "Bribe requested", "Stopped/given warning")))
obs_freq
N   <- sum(obs_freq)
exp_freq <- outer(rowSums(obs_freq), colSums(obs_freq)) / N
exp_freq
chi_square <- sum((obs_freq - exp_freq)^2 / exp_freq)
chi_square
chisq.test(obs_freq)
