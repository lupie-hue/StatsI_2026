geom_histogram(bins = 30, fill = "steelblue", color = "white", alpha = 0.7) +
facet_wrap(~Variable, scales = "free", ncol = 3) +
theme_minimal(base_size = 12) +
labs(title = "Histograms of Variables", x = NULL, y = "Count")
# VERSION Remove Malta's FDI value
mutate(FDI = ifelse(`Country Name` == "Malta", NA, FDI)) %>%
pivot_longer(cols = where(is.numeric), names_to = "Variable", values_to = "Value") %>%
ggplot(aes(x = Value)) +
geom_histogram(bins = 30, fill = "steelblue", color = "white", alpha = 0.7) +
facet_wrap(~Variable, scales = "free", ncol = 3) +
theme_minimal(base_size = 12) +
labs(title = "Histograms of Variables", x = NULL, y = "Count")
# ---- SIMPLE REGRESSION OUTPUT TABLE ----
library(broom)
library(kableExtra)
# Run the simple regression (GDPxcapita ~ PRI)
model_simple <- lm(GDPxcapita ~ PRI, data = data)
# Model summary components
sum_model <- summary(model_simple)
anova_model <- anova(model_simple)
# Build a regression summary table
regression_stats <- tibble::tibble(
`Regression Statistics` = c(
"Multiple R",
"R Square",
"Adjusted R Square",
"Standard Error",
"Observations"
),
Value = c(
round(sqrt(sum_model$r.squared), 6),
round(sum_model$r.squared, 6),
round(sum_model$adj.r.squared, 6),
round(sum_model$sigma, 6),
nobs(model_simple)
)
)
# Build the ANOVA-style table
anova_tbl <- tibble::tibble(
Source = c("Regression", "Residual", "Total"),
df = c(anova_model$Df, NA),
SS = c(round(sum(anova_model$`Sum Sq`[1]), 6),
round(sum(anova_model$`Sum Sq`[2]), 6),
round(sum(anova_model$`Sum Sq`), 6)),
MS = c(round(anova_model$`Mean Sq`[1], 6),
round(anova_model$`Mean Sq`[2], 6),
NA),
F = c(round(sum_model$fstatistic[1], 6), NA, NA),
`Significance F` = c(round(pf(sum_model$fstatistic[1],
sum_model$fstatistic[2],
sum_model$fstatistic[3],
lower.tail = FALSE), 6), NA, NA)
)
# Coefficients table
coef_tbl <- broom::tidy(model_simple, conf.int = TRUE) %>%
dplyr::mutate(across(where(is.numeric), round, 6)) %>%
dplyr::rename(
Coefficients = term,
`Standard Error` = std.error,
`t Stat` = statistic,
`P-value` = p.value,
`Lower 95%` = conf.low,
`Upper 95%` = conf.high
) %>%
dplyr::select(Coefficients, estimate, `Standard Error`, `t Stat`, `P-value`, `Lower 95%`, `Upper 95%`)
# ---- PRINT FORMATTED TABLES ----
# Regression statistics
regression_stats %>%
kable(caption = "SUMMARY OUTPUT — Regression Statistics") %>%
kable_styling(full_width = FALSE, position = "center", bootstrap_options = c("hover", "condensed"))
# ANOVA table
anova_tbl %>%
kable(caption = "ANOVA") %>%
kable_styling(full_width = FALSE, position = "center", bootstrap_options = c("hover", "condensed"))
# Coefficients table
coef_tbl %>%
kable(caption = "Coefficients") %>%
kable_styling(full_width = FALSE, position = "center", bootstrap_options = c("hover", "condensed"))
