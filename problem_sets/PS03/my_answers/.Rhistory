calculate_median <- function(a) {
a <- sort(a)
n <- length(a)
m <- (n + 1) %/% 2
if (n %% 2 == 1) {
med <- a[m]
} else {
browser()
med <- mean(a[m:m+1])
}
return(med)
}
v2 <- c(0, 1, 2, 2)
calculate_median(v2)
calculate_median(v2)
