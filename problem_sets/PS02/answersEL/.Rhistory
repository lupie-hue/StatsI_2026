# a) calculate chi-square test statistic by hand
# Use chi-square when we have categorical variables
# H0: variables are independent
# HA: variables are dependent
# Observed frequencies
obs_freq <- matrix(c(14, 6, 7,
7, 7, 1),
nrow = 2, byrow = TRUE,
dimnames = list(c("Upper class", "Lower class"),
c("Not stopped", "Bribe requested", "Stopped/given warning")))
print(obs_freq)
# Step 1: row totals, column totals and grand total
row_tot <- rowSums(obs_freq)
col_tot <- colSums(obs_freq)
n <- sum(obs_freq)
print(row_tot)
print(col_tot)
print(n)
# Observed table with totals
obs_with_totals <- addmargins(obs_freq, FUN = sum)
print(obs_with_totals)
output_stargazer("obs_freq.tex", obs_with_totals,
title = "Observed frequencies",
label = "tab:obs_freq",
digits = 0, header = FALSE, table.placement = "H")
# Step 2: expected frequencies under independence
# f_e = (row total * column total) / n
exp_freq <- outer(row_tot, col_tot) / n
print(exp_freq)
output_stargazer("exp_freq.tex", exp_freq,
title = "Expected frequencies under independence",
label = "tab:exp_freq",
digits = 3, header = FALSE, table.placement = "H")
# Check that all expected frequencies are >= 5
if (any(exp_freq < 5)) {
message("Warning: at least one expected frequency is below 5. ",
"The chi-square approximation may be unreliable.")
}
# Frequency should be >= 5 for all cells, but this is not the case.
# The chi-square approximation may therefore be unreliable.
# Step 3: (f_o - f_e)^2 / f_e
# chi-square statistic = sum of all contributions
chi_square <- sum((obs_freq - exp_freq)^2 / exp_freq)
print(chi_square)
# b) calculate p-value from the test statistic
# degrees of freedom = (rows - 1) * (columns - 1)
df <- (nrow(obs_freq) - 1) * (ncol(obs_freq) - 1)
print(df)
# upper-tail probability of the chi-square distribution
p_value <- pchisq(chi_square, df = df, lower.tail = FALSE)
print(p_value)
# what do you conclude if alpha = 0.1?
# Since p = 0.150 > 0.1 = alpha, we fail to reject H0 of independence: there
# is not sufficient evidence that police behaviour depends on driver class.
# Built-in function check for both the chi-square stat and p-value
chisq.test(obs_freq)
# (R warns that the approximation may be incorrect because some expected
# counts are below 5)
# c) calculate the standardized residuals
# z = (f_o - f_e) / sqrt(f_e * (1 - row proportion) * (1 - column proportion))
row_prop <- row_tot / n
col_prop <- col_tot / n
se <- sqrt(exp_freq * outer(1 - row_prop, 1 - col_prop))
std_res <- (obs_freq - exp_freq) / se
print(round(std_res, 2))
output_stargazer("std_res.tex", std_res,
title = "Standardized residuals",
label = "tab:std_res",
digits = 2, header = FALSE, table.placement = "H")
# Built-in function check
chisq.test(obs_freq)$stdres
# d) how might the standardized residuals help interpret the results?
# They show which cells drive the chi-square statistic and in which direction.
# Lower class drivers were asked for bribes more often than expected (+1.64)
# and upper class drivers more often got warnings (+1.52). However, no residual
# exceeds |1.96|, so no single cell departs significantly from independence,
# consistent with the overall test not rejecting H0.
#####################
# Problem 2
#####################
dataset <- read.csv("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv")
head(dataset)   # first six rows
str(dataset)    # variable names and types
dim(dataset)    # number of rows and columns
# a) state a null and alternative (two-tailed) hypothesis
# H0: beta_1 = 0    (X and Y are not linearly related)
# HA: beta_1 != 0   (X and Y are linearly related)
# b) run a bivariate regression to test this hypothesis
# x = reserved, y = water, n_obs = observations
x <- dataset$reserved
y <- dataset$water
n_obs <- length(y)
print(n_obs)
# Step 1: compute the means
x_bar <- mean(x)
y_bar <- mean(y)
print(x_bar)
print(y_bar)
# Step 2: slope and intercept
Sxy <- sum((x - x_bar) * (y - y_bar))   # sum of products
Sxx <- sum((x - x_bar)^2)   # sum of squares
b1 <- Sxy / Sxx   # slope
b0 <- y_bar - b1 * x_bar   # intercept
print(Sxy)
print(Sxx)
print(b1)
print(b0)
# Step 3: fitted values, residuals and residual variance
fitted_values <- b0 + b1 * x   # prediction for each village
residuals <- y - fitted_values   # actual minus predicted
sigma2 <- sum(residuals^2) / (n_obs - 2)   # residual variance
# (dividing by n - 2 because 2 parameters are estimated)
print(sum(residuals^2))
print(sigma2)
# Step 4: standard error of the slope
se_b1 <- sqrt(sigma2 / Sxx)
print(se_b1)
# Step 5: t-statistic under H0: beta_1 = 0
t_stat <- (b1 - 0) / se_b1
print(t_stat)
# Step 6: two-tailed p-value with n - 2 degrees of freedom
# multiplied by 2 because HA: beta_1 != 0 (both tails)
df_reg <- n_obs - 2
p_value_reg <- 2 * pt(abs(t_stat), df = df_reg, lower.tail = FALSE)
print(df_reg)
print(p_value_reg)
# p = 0.0197: if the policy had no effect, a difference this large would
# occur only about 2% of the time. Since p < 0.05, we reject H0
# Step 7: 95% confidence interval for beta_1
# b1 +/- t_crit * se(b1)
t_crit <- qt(0.975, df = df_reg)
ci_low <- b1 - t_crit * se_b1
ci_high <- b1 + t_crit * se_b1
print(t_crit)
print(c(ci_low, ci_high))
# 95% CI = [1.49, 17.02]: it does not contain 0, confirming the rejection
# of H0, but it is wide, so the exact size of the effect is uncertain
# Built-in function check
model <- lm(water ~ reserved, data = dataset)
summary(model)
output_stargazer("regression.tex", model,
title = "Effect of the reservation policy on drinking water facilities",
label = "tab:regression",
dep.var.labels = "New or repaired drinking water facilities",
covariate.labels = c("Reserved", "Constant"),
header = FALSE, table.placement = "H")
# Conclusion: t = 2.34, df = 320, p = 0.0197 < 0.05, so we reject H0: beta_1 = 0
# at the 5% level. The 95% CI [1.49, 17.02] does not contain 0, confirming this.
# (If instead of 95% we used 99% then we would fail to reject H0)
b1 + c(-1, 1) * qt(0.995, df = df_reg) * se_b1   # 0 is in the interval
# c) interpret the coefficient estimate for reservation policy
# b0 = 14.74: average number of new or repaired drinking water facilities in
# villages whose GP was not reserved (reserved = 0).
# b1 = 9.25: difference in that average between reserved and unreserved
# villages, so reserved villages have 14.74 + 9.25 = 23.99 facilities on average.
